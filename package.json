{
  "name": "@pnfo/singlish-search",
  "version": "1.4.1",
  "description": "search Sinhala text using Singlish letters",
  "main": "singlish.js",
  "files": [
    "singlish.js",
    "singlish-model.js",
    "roman_convert.js"
  ],
  "type": "module",
  "scripts": {
    "corpus": "node scripts/extract-corpus.mjs && node scripts/build-gold.mjs",
    "build-model": "node scripts/build-model.mjs --minCount=20 --step=0.5",
    "eval": "node scripts/eval.mjs",
    "golden": "node scripts/build-golden.mjs",
    "test": "NODE_OPTIONS='--experimental-vm-modules' jest && go test ./...",
    "publish": "npm publish --access public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pnfo/singlish-search.git"
  },
  "keywords": [
    "singlish",
    "search",
    "sinhala"
  ],
  "author": "pathnirvana",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/pnfo/singlish-search/issues"
  },
  "homepage": "https://github.com/pnfo/singlish-search#readme",
  "devDependencies": {
    "jest": "^29.3.1",
    "singlish-v125": "npm:@pnfo/singlish-search@1.2.5",
    "singlish-v127": "npm:@pnfo/singlish-search@1.2.7"
  }
}
